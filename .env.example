# ---- Cloudflare R2 (S3 호환) 인증 정보 : R2 업로드를 쓸 때만 필요 ----
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ACCOUNT_ID=
BUCKET_NAME=
# 버킷의 공개 URL (선택). 앱별 BASE_URL 이 없을 때 버전 서버 등록에 사용된다.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ---- 선택 사항 (config.json 의 common 값을 덮어쓴다) ----
# INNO_SETUP_EXE=C:\Program Files (x86)\Inno Setup 6\ISCC.exe
# VERSION_API_URL=http://localhost:3009
# PY2EXE_CONFIG=C:/path/to/other/config.json

# ---- 버전 관리 서버 (version/run.py) ----
# VERSION_API_HOST=0.0.0.0
# VERSION_API_PORT=3009
# VERSION_API_RELOAD=0
# VERSIONS_FILE=/path/to/versions.json
